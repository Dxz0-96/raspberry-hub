# Settings for deploy.ps1. Copy this file to .env (ignored by git) and change the values for your Raspberry Pi.
# Plain KEY=value lines: nothing here is run. -Pi and -Key on the command line win over these values.

# Raspberry Pi to deploy to (SSH user@host), and the SSH key to use (~ is your user folder)
PI_HOST=pi@raspberry
PI_SSH_KEY=~/.ssh/id_ed25519

# Address of the hub, printed at the end of a deploy
HUB_URL=https://raspberry/
