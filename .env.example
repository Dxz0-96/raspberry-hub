# Settings for deploy.ps1. Copy this file to .env (ignored by git) and change the values for your Raspberry Pi.
# Plain KEY=value lines: nothing here is run. -Pi and -Key on the command line win over these values.

# Raspberry Pi to deploy to (SSH user@host), and the SSH key to use (~ is your user folder)
PI_HOST=pi@raspberry
PI_SSH_KEY=~/.ssh/id_ed25519

# Address of the hub, printed at the end of a deploy
HUB_URL=https://raspberry/

# Only for a new installation (deploy.ps1 -Update on a Raspberry Pi without the hub): the country of the offline
# map and of the address search, as an ISO 3166 code (IT, FR, CH...). Empty: hub-install.sh asks.
# sudo hub-install.sh configure changes it later.
MAP_COUNTRY=
# The same for the offline Wikipedia: its language as Kiwix names it (it, en, de...) and the variant: maxi (with
# images), nopic or mini. Independent of the country: the map of Italy does not imply Italian Wikipedia.
WIKI_LANGUAGE=
WIKI_VARIANT=
