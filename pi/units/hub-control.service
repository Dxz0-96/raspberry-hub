[Unit]
Description=raspberry-hub: service status and switches, hardware monitor
After=network.target pihole-FTL.service

[Service]
User=hubctl
Group=hubctl
# pihole: for "pihole enable/disable" without sudo. video: to read the power supply state (vcgencmd).
SupplementaryGroups=pihole video
ExecStart=/usr/bin/python3 /usr/local/lib/raspberry-hub/hub-control.py
Restart=on-failure
RestartSec=5
MemoryMax=96M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/hub-control /srv/hub/config /srv/hub/icons /etc/hub-control

[Install]
WantedBy=multi-user.target
