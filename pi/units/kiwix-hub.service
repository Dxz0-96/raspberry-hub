[Unit]
Description=raspberry-hub: offline Wikipedia (kiwix-serve)
After=network.target
# Switched off from the hub: stays off after a reboot too, until it is switched back on.
ConditionPathExists=!/var/lib/hub-control/wikipedia.off
# Something downloaded: an edition and its link wikipedia_<language>.zim (hub-update.sh wiki)
ConditionPathExistsGlob=/srv/hub/zim/wikipedia_*.zim

[Service]
DynamicUser=yes
# kiwix-serve with every downloaded language (see the script)
ExecStart=/usr/local/lib/raspberry-hub/kiwix-start
Restart=on-failure
RestartSec=10
Nice=5
MemoryHigh=280M
MemoryMax=420M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
