[Unit]
Description=Hub di casa: stato e interruttori dei servizi, monitor dell'hardware
After=network.target pihole-FTL.service

[Service]
User=hubctl
Group=hubctl
# pihole: per "pihole enable/disable" senza sudo. video: per leggere lo stato dell'alimentazione (vcgencmd).
SupplementaryGroups=pihole video
ExecStart=/usr/bin/python3 /usr/local/lib/raspberry-hub/hub-control.py
Restart=on-failure
RestartSec=5
MemoryMax=96M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/hub-control /srv/hub/config /srv/hub/icone /etc/hub-control

[Install]
WantedBy=multi-user.target
