#!/usr/bin/env python3
"""Hooks other services into raspberry-hub.

    sudo hub-service list
    sudo hub-service add            asks the questions one at a time
    sudo hub-service remove ID

Simple links (NAS, router, another page) can also be added from the hub, with "Add service".
This command is for what touches the system:
  - publishing a service that runs on this Raspberry Pi under https://raspberry/<path>/
    (writes a snippet to /etc/caddy/services/ and reloads Caddy);
  - giving the service an on/off switch in the hub (adds its systemd unit to the list of units
    the hub may start and stop).
"""
import json
import os
import re
import shutil
import subprocess
import sys

SERVICES_FILE = "/srv/hub/config/services.json"
ICONS_DIR = "/srv/hub/icons"
CADDY_DIR = "/etc/caddy/services"
ALLOWED_UNITS_FILE = "/etc/hub-control/allowed-units"
POLKIT_RULE = "/etc/polkit-1/rules.d/50-hub-control.rules"
BUILT_IN = ("pihole", "wikipedia", "maps")
RESERVED = {"admin", "api", "netmon", "wiki", "search", "control", "tiles", "icons", "maps", "hardware",
            "unavailable", "_next", "services.json", "status.json", "ca.crt", "mappe"}


def read_services():
    try:
        with open(SERVICES_FILE, encoding="utf-8") as f:
            return json.load(f).get("services", [])
    except (OSError, ValueError):
        return []


def write_services(services):
    temporary = SERVICES_FILE + ".tmp"
    with open(temporary, "w", encoding="utf-8") as f:
        json.dump({"services": services}, f, ensure_ascii=False, indent=2)
        f.write("\n")
    shutil.chown(temporary, "hubctl", "hubctl")
    os.chmod(temporary, 0o664)
    os.replace(temporary, SERVICES_FILE)


def read_units():
    try:
        with open(ALLOWED_UNITS_FILE, encoding="utf-8") as f:
            return [line.strip() for line in f if line.strip() and not line.startswith("#")]
    except OSError:
        return []


def write_rule(units):
    """Rewrites the list of units and the polkit rule that lets hubctl control them."""
    os.makedirs(os.path.dirname(ALLOWED_UNITS_FILE), exist_ok=True)
    with open(ALLOWED_UNITS_FILE, "w", encoding="utf-8") as f:
        f.write("# systemd units the hub may start and stop. Managed by hub-service.\n")
        f.write("".join(u + "\n" for u in units))
    os.chmod(ALLOWED_UNITS_FILE, 0o644)
    with open(POLKIT_RULE, "w", encoding="utf-8") as f:
        f.write("// raspberry-hub: the hubctl user may start and stop ONLY these units.\n"
                "// Generated by hub-service and hub-install.sh: manual changes are overwritten.\n"
                "polkit.addRule(function(action, subject) {\n"
                "    if (action.id !== \"org.freedesktop.systemd1.manage-units\" || subject.user !== \"hubctl\") {\n"
                "        return polkit.Result.NOT_HANDLED;\n"
                "    }\n"
                f"    var units = {json.dumps(units)};\n"
                "    var verbs = [\"start\", \"stop\", \"restart\"];\n"
                "    if (units.indexOf(action.lookup(\"unit\")) >= 0 && verbs.indexOf(action.lookup(\"verb\")) >= 0) {\n"
                "        return polkit.Result.YES;\n"
                "    }\n"
                "    // the restart button of the hub: only starting the unit that restarts the Raspberry Pi\n"
                "    if (action.lookup(\"unit\") === \"hub-reboot.service\" && action.lookup(\"verb\") === \"start\") {\n"
                "        return polkit.Result.YES;\n"
                "    }\n"
                "    // the \"Go back\" button of the hub, after an upgrade that went wrong: only starting it\n"
                "    if (action.lookup(\"unit\") === \"hub-rollback.service\" && action.lookup(\"verb\") === \"start\") {\n"
                "        return polkit.Result.YES;\n"
                "    }\n"
                "    // the \"Update\" button of the hub: only starting an upgrade to a version number\n"
                "    if (/^hub-upgrade@[0-9]+\\.[0-9]+\\.[0-9]+\\.service$/.test(action.lookup(\"unit\")) &&\n"
                "        action.lookup(\"verb\") === \"start\") {\n"
                "        return polkit.Result.YES;\n"
                "    }\n"
                "    return polkit.Result.NO;\n"
                "});\n")
    os.chmod(POLKIT_RULE, 0o644)


def ask(question, default="", required=False):
    while True:
        answer = input(f"{question}{f' [{default}]' if default else ''}: ").strip() or default
        if answer or not required:
            return answer
        print("  This field is required.")


def reload_caddy():
    if subprocess.run(["caddy", "validate", "--config", "/etc/caddy/Caddyfile"], capture_output=True).returncode != 0:
        return False
    subprocess.run(["systemctl", "reload", "caddy"], check=False)
    return True


def list_services():
    units = set(read_units())
    for s in read_services():
        traits = [s.get("type", "link")]
        if s.get("unit"):
            traits.append(f"unit {s['unit']}" + ("" if s["unit"] in units else " (not controllable)"))
        if s.get("added"):
            traits.append("added from the hub")
        print(f"{s.get('id', '?'):14} {s.get('name', ''):22} {s.get('url', ''):34} {', '.join(traits)}")
    return 0


def add():
    services = read_services()
    taken = {s.get("id") for s in services}
    print("New service for the hub (press Enter to leave an optional field empty)\n")
    name = ask("Name shown in the hub", required=True)[:40]
    ident = ask("ID (lower case letters, digits and dashes)", re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")[:20], True)
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,40}", ident) or ident in taken or ident in RESERVED:
        print("Invalid or already used ID.", file=sys.stderr)
        return 1
    description = ask("Short description")[:80]
    service = {"id": ident, "name": name, "description": description, "type": "link"}

    port = ask("Local port of the service on this Raspberry Pi (empty if it runs on another device)")
    if port:
        if not port.isdigit() or not 1 <= int(port) <= 65535:
            print("The port must be a number between 1 and 65535.", file=sys.stderr)
            return 1
        print("  Note: this only works with applications that accept being served under a path.")
        path = ask("Path under https://raspberry/", ident, True).strip("/")
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,40}", path) or path in RESERVED:
            print("Invalid path, or reserved for the hub.", file=sys.stderr)
            return 1
        os.makedirs(CADDY_DIR, exist_ok=True)
        snippet = os.path.join(CADDY_DIR, f"{ident}.caddy")
        with open(snippet, "w", encoding="utf-8") as f:
            f.write(f"# {name}: added by hub-service\nredir /{path} /{path}/ 308\n"
                    f"handle /{path}/* {{\n\treverse_proxy 127.0.0.1:{port}\n}}\n")
        if not reload_caddy():
            os.remove(snippet)
            print("Caddy does not accept the new configuration: nothing was changed.", file=sys.stderr)
            return 1
        service.update(url=f"/{path}/", check=f"tcp://127.0.0.1:{port}")
    else:
        url = ask("Full address (e.g. http://192.168.1.20/)", required=True)
        if not re.match(r"^https?://[^\s]+$", url):
            print("The address must start with http:// or https://", file=sys.stderr)
            return 1
        service["url"] = url

    unit = ask("systemd unit for the on/off switch (empty = no switch)")
    if unit:
        if not unit.endswith(".service"):
            unit += ".service"
        if subprocess.run(["systemctl", "cat", unit], capture_output=True).returncode != 0:
            print(f"The unit {unit} does not exist on this Raspberry Pi.", file=sys.stderr)
            return 1
        service.update(type="unit", unit=unit)
        drop_in = f"/etc/systemd/system/{unit}.d"
        os.makedirs(drop_in, exist_ok=True)
        with open(os.path.join(drop_in, "hub-control.conf"), "w", encoding="utf-8") as f:
            f.write(f"# Turned off from the hub: stays off after a reboot too.\n[Unit]\n"
                    f"ConditionPathExists=!/var/lib/hub-control/{ident}.off\n")
        write_rule(sorted(set(read_units()) | {unit}))
        subprocess.run(["systemctl", "daemon-reload"], check=False)

    icon = ask("Image file for the icon on this Raspberry Pi (PNG, JPEG, WebP or SVG; empty = first letter of the name)")
    if icon:
        extension = os.path.splitext(icon)[1].lower()
        if not os.path.isfile(icon) or extension not in (".png", ".jpg", ".jpeg", ".webp", ".svg"):
            print("Image not found or format not accepted: the service will be added without an icon.")
        else:
            destination = os.path.join(ICONS_DIR, f"{ident}{extension}")
            shutil.copyfile(icon, destination)
            shutil.chown(destination, "hubctl", "hubctl")
            os.chmod(destination, 0o644)
            service["icon"] = f"/icons/{ident}{extension}"

    write_services(services + [service])
    subprocess.run(["systemctl", "try-restart", "hub-control.service"], check=False)
    print(f"\nDone: \"{name}\" appears in the hub the next time the page loads.")
    return 0


def remove(ident):
    services = read_services()
    service = next((s for s in services if s.get("id") == ident), None)
    if not service:
        print(f"No service with ID \"{ident}\". Use: sudo hub-service list", file=sys.stderr)
        return 1
    if ident in BUILT_IN:
        print("The hub's built-in services cannot be removed from here.", file=sys.stderr)
        return 1
    write_services([s for s in services if s.get("id") != ident])
    snippet = os.path.join(CADDY_DIR, f"{ident}.caddy")
    if os.path.exists(snippet):
        os.remove(snippet)
        reload_caddy()
    unit = service.get("unit")
    if unit:
        try:
            os.remove(f"/etc/systemd/system/{unit}.d/hub-control.conf")
            os.rmdir(f"/etc/systemd/system/{unit}.d")
        except OSError:
            pass
        write_rule([u for u in read_units() if u != unit])
        subprocess.run(["systemctl", "daemon-reload"], check=False)
    icon = os.path.join(ICONS_DIR, os.path.basename(service.get("icon", "")))
    if service.get("icon") and os.path.isfile(icon):
        os.remove(icon)
    marker = f"/var/lib/hub-control/{ident}.off"
    if os.path.exists(marker):
        os.remove(marker)
    subprocess.run(["systemctl", "try-restart", "hub-control.service"], check=False)
    print(f"Removed \"{service.get('name', ident)}\".")
    return 0


def main():
    args = sys.argv[1:]
    if not args or args[0] not in ("list", "add", "remove", "rule"):
        print(__doc__)
        return 2
    if os.geteuid() != 0:
        print("Run it with sudo.", file=sys.stderr)
        return 1
    if args[0] == "list":
        return list_services()
    if args[0] == "add":
        return add()
    if args[0] == "rule":                   # used by hub-install.sh: regenerates the polkit rule from the list
        write_rule(read_units() or ["kiwix-hub.service", "hub-search.service"])
        return 0
    if len(args) != 2:
        print("Usage: sudo hub-service remove ID", file=sys.stderr)
        return 2
    return remove(args[1])


if __name__ == "__main__":
    sys.exit(main())
