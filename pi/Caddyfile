# raspberry-hub: Caddy receives all the web traffic of the Raspberry Pi (ports 80 and 443) and routes it.
# The certificate is the one from the "home CA" issued by pihole-cert.sh; hub-cert-sync copies it here
# and reloads Caddy at every renewal. After a change: sudo caddy validate --config /etc/caddy/Caddyfile
# and then sudo systemctl reload caddy.
{
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

# ---------------------------------------------------------------- pages of the hub (the website and its error pages)
# - frame-ancestors / X-Frame-Options: no other site may show the hub inside one of its pages, where a click on
#   what looks like something else would log in, flip a switch or start an update (clickjacking).
# - The rest of the policy: the pages load scripts, styles, fonts, images and data only from the Raspberry Pi
#   itself, and send forms nowhere else. 'unsafe-inline' is needed by the static export, which puts its start-up
#   data and the theme and language scripts inline. Wikipedia (/wiki/) is not covered: the hub shows it in a
#   frame of its own, and it has no buttons that change anything.
# No Strict-Transport-Security: the certificate comes from the home CA, and a device that has not imported it
# yet downloads it from http://raspberry/ca.crt, which HSTS would turn into an error that cannot be skipped.
(hub_pages) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
		X-Frame-Options SAMEORIGIN
	}
}

# ---------------------------------------------------------------- HTTP: only the CA and the redirect to HTTPS
:80 {
	handle /ca.crt {
		root * /etc/caddy/public
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=\"home-ca.crt\""
		file_server
	}
	@same host pi.hole @RASPBERRY_IP@
	handle @same {
		redir https://{host}{uri} 308
	}
	handle {
		redir https://raspberry{uri} 308
	}
}

# ---------------------------------------------------------------- HTTPS
https://raspberry, https://pi.hole, https://@RASPBERRY_IP@ {
	tls /etc/caddy/certs/tls.pem /etc/caddy/certs/tls.pem
	encode zstd gzip

	# One line per request to the control service, over local UDP and in memory only:
	# used to count the visits to Wikipedia, the maps and the other services. Nothing on disk,
	# no headers (so no cookies).
	log {
		output net udp/127.0.0.1:8084
		format filter {
			wrap json
			fields {
				request>headers delete
				request>tls delete
				resp_headers delete
			}
		}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	# Pi-hole: dashboard, API and network monitor page (its web server listens only locally)
	@pihole path /admin /admin/* /api /api/* /netmon /netmon/*
	handle @pihole {
		reverse_proxy 127.0.0.1:8080
	}

	# Offline Wikipedia (kiwix-serve)
	redir /wiki /wiki/ 308
	handle /wiki/* {
		reverse_proxy 127.0.0.1:8081
	}

	# Address search
	handle /search* {
		reverse_proxy 127.0.0.1:8082
	}

	# Service status and switches, hardware monitor
	handle /control/* {
		reverse_proxy 127.0.0.1:8083
	}

	# Maps: a single PMTiles file, read in pieces by the browser. Switched off from the hub -> unavailable.
	handle_path /tiles/* {
		@off file {
			root /var/lib/hub-control
			try_files /maps.off
		}
		respond @off "Maps switched off from the hub" 503
		root * /srv/hub/maps
		file_server
	}

	# Service icons: images uploaded from the hub, never executed
	handle_path /icons/* {
		root * /srv/hub/icons
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
		header Cache-Control "public, max-age=300"
		file_server
	}

	handle /services.json {
		root * /srv/hub/config
		header Cache-Control no-store
		file_server
	}
	handle /status.json {
		root * /srv/hub
		header Cache-Control no-store
		file_server
	}
	handle /ca.crt {
		root * /etc/caddy/public
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=\"home-ca.crt\""
		file_server
	}

	# Bookmarks from raspberry-hub 1.x (the browser keeps the #position=... part)
	redir /mappe /maps/ 308
	redir /mappe/ /maps/ 308

	# Local services hooked in with "sudo hub-service add"
	import services/*.caddy

	# The hub website (Next.js static export)
	handle {
		root * /srv/hub/site
		import hub_pages
		@immutable path /_next/static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}/index.html {path}.html
		file_server
	}

	handle_errors {
		root * /srv/hub/site
		import hub_pages
		@unavailable expression {http.error.status_code} == 502 || {http.error.status_code} == 503
		handle @unavailable {
			rewrite * /unavailable/index.html
			file_server {
				status {http.error.status_code}
			}
		}
		@missing expression {http.error.status_code} == 404
		handle @missing {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
		handle {
			respond "{http.error.status_code} {http.error.status_text}"
		}
	}
}
