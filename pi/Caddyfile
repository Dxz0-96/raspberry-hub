# Hub di casa: Caddy riceve tutto il traffico web del Raspberry (porte 80 e 443) e lo smista.
# Il certificato e' quello della "CA di casa" emesso da pihole-cert.sh; hub-cert-sync lo copia qui
# e ricarica Caddy a ogni rinnovo. Dopo una modifica: sudo caddy validate --config /etc/caddy/Caddyfile
# e poi sudo systemctl reload caddy.
{
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

# ---------------------------------------------------------------- HTTP: solo CA e rinvio a HTTPS
:80 {
	handle /ca.crt {
		root * /etc/caddy/pubblico
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=\"ca-di-casa.crt\""
		file_server
	}
	@stesso host pi.hole @IP_RASPBERRY@
	handle @stesso {
		redir https://{host}{uri} 308
	}
	handle {
		redir https://raspberry{uri} 308
	}
}

# ---------------------------------------------------------------- HTTPS
https://raspberry, https://pi.hole, https://@IP_RASPBERRY@ {
	tls /etc/caddy/certs/tls.pem /etc/caddy/certs/tls.pem
	encode zstd gzip

	# Una riga per richiesta al servizio di controllo, via UDP in locale e solo in memoria:
	# serve a contare le visite a Wikipedia, alle mappe e agli altri servizi. Niente su disco,
	# niente intestazioni (quindi niente cookie).
	log {
		output net udp/127.0.0.1:8084
		format filter {
			wrap json
			fields {
				request>headers delete
				request>tls delete
				resp_headers delete
			}
		}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	# Pi-hole: dashboard, API e pagina del monitor di rete (il suo web ascolta solo in locale)
	@pihole path /admin /admin/* /api /api/* /netmon /netmon/*
	handle @pihole {
		reverse_proxy 127.0.0.1:8080
	}

	# Wikipedia offline (kiwix-serve)
	redir /wiki /wiki/ 308
	handle /wiki/* {
		reverse_proxy 127.0.0.1:8081
	}

	# Ricerca degli indirizzi
	handle /cerca* {
		reverse_proxy 127.0.0.1:8082
	}

	# Stato e interruttori dei servizi, monitor dell'hardware
	handle /controllo/* {
		reverse_proxy 127.0.0.1:8083
	}

	# Mappe: un solo file PMTiles, letto a pezzi dal browser. Spente dall'hub -> non disponibili.
	handle_path /tiles/* {
		@spente file {
			root /var/lib/hub-control
			try_files /mappe.off
		}
		respond @spente "Mappe spente dall'hub" 503
		root * /srv/hub/maps
		file_server
	}

	# Icone dei servizi: immagini caricate dall'hub, mai eseguite
	handle_path /icone/* {
		root * /srv/hub/icone
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
		header Cache-Control "public, max-age=300"
		file_server
	}

	handle /servizi.json {
		root * /srv/hub/config
		header Cache-Control no-store
		file_server
	}
	handle /status.json {
		root * /srv/hub
		header Cache-Control no-store
		file_server
	}
	handle /ca.crt {
		root * /etc/caddy/pubblico
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=\"ca-di-casa.crt\""
		file_server
	}

	# Servizi locali agganciati con "sudo hub-servizio aggiungi"
	import servizi/*.caddy

	# Il sito dell'hub (export statico di Next.js)
	handle {
		root * /srv/hub/site
		@fissi path /_next/static/*
		header @fissi Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}/index.html {path}.html
		file_server
	}

	handle_errors {
		root * /srv/hub/site
		@spento expression {http.error.status_code} == 502 || {http.error.status_code} == 503
		handle @spento {
			rewrite * /spento/index.html
			file_server {
				status {http.error.status_code}
			}
		}
		@manca expression {http.error.status_code} == 404
		handle @manca {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
		handle {
			respond "{http.error.status_code} {http.error.status_text}"
		}
	}
}
