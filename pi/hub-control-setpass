#!/usr/bin/env python3
"""Sets the username and password for the switches of raspberry-hub.

    sudo hub-control-setpass

You type the password and it is not shown. Only its scrypt hash stays on the Raspberry Pi,
in /etc/hub-control/credentials.json, readable by root and by the hub service.
Run it again whenever you want to change them; the password can also be changed from the hub.
"""
import base64
import getpass
import grp
import hashlib
import json
import os
import secrets
import subprocess
import sys

CREDENTIALS_FILE = "/etc/hub-control/credentials.json"
SESSIONS_FILE = "/var/lib/hub-control/sessions.json"


def main():
    if os.geteuid() != 0:
        print("Run it with sudo.", file=sys.stderr)
        return 1
    current = "admin"
    try:
        with open(CREDENTIALS_FILE, encoding="utf-8") as f:
            current = json.load(f).get("username") or current
    except (OSError, ValueError):
        pass
    print("Login for the hub switches")
    username = input(f"Username [{current}]: ").strip() or current
    if not 1 <= len(username) <= 40 or any(c.isspace() for c in username):
        print("The username must be 1 to 40 characters long, without spaces.", file=sys.stderr)
        return 1
    password = getpass.getpass("New password (at least 8 characters, not shown): ")
    if len(password) < 8:
        print("Too short: at least 8 characters are needed. Nothing was changed.", file=sys.stderr)
        return 1
    if getpass.getpass("Repeat the password: ") != password:
        print("The two passwords are different. Nothing was changed.", file=sys.stderr)
        return 1

    salt = secrets.token_bytes(16)
    derived = hashlib.scrypt(password.encode("utf-8"), salt=salt, n=16384, r=8, p=1, dklen=32,
                             maxmem=64 * 1024 * 1024)
    os.makedirs(os.path.dirname(CREDENTIALS_FILE), mode=0o750, exist_ok=True)
    temporary = CREDENTIALS_FILE + ".tmp"
    with open(os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8") as f:
        json.dump({"username": username, "salt": base64.b64encode(salt).decode(),
                   "hash": base64.b64encode(derived).decode(), "n": 16384, "r": 8, "p": 1}, f)
        f.write("\n")
    try:
        group = grp.getgrnam("hubctl").gr_gid
    except KeyError:
        group = 0
    os.chown(temporary, 0, group)
    os.chmod(temporary, 0o660)
    os.replace(temporary, CREDENTIALS_FILE)
    # whoever was logged in must log in again with the new credentials: drop all saved sessions
    try:
        os.remove(SESSIONS_FILE)
    except FileNotFoundError:
        pass
    subprocess.run(["systemctl", "try-restart", "hub-control.service"], check=False)
    print(f"Done. Username: {username}. You can now log in from the hub.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
